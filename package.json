{
  "name": "@trofimyukdev/repo-truth",
  "version": "0.1.0",
  "description": "Checks over a git commit range for the moves that make a repository look healthier than it is: weakened tests, lowered thresholds, loosened workflows, committed credentials and more.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repo-truth": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trofimyukdev/repo-truth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
